# Supabase — create a project at https://supabase.com/dashboard, then copy
# these from Project Settings > API. Auth (email/password + Google) and the
# onboarding_responses table both depend on these being set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API > service_role key. Server-only, never exposed to
# the browser — used to read the Stripe key each user connects in /espace
# (that table has no client SELECT policy by design).
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys. Server-only. Powers the build/marketing
# prompt generator and the in-app assistant (including screenshot analysis);
# both fall back to static content when this is unset.
ANTHROPIC_API_KEY=

# SaaSFounder's own subscription billing (Stripe Dashboard > Developers >
# API keys / Webhooks). Distinct from the per-user Stripe keys stored in
# stripe_connections, which read each user's OWN account for their MRR.
# Without these, /tarifs still renders but "Choisir" fails gracefully.
STRIPE_SECRET_KEY=
# From the webhook endpoint's "Signing secret" once created (see below).
STRIPE_WEBHOOK_SECRET=

# Prices: none to configure. Checkout finds each plan's Stripe price by its
# lookup key (saasfounder_monthly_launch, saasfounder_lifetime_exit, ...)
# and, in a Stripe account that has none yet, creates the products and
# prices itself (lib/stripe/prices.ts). Old STRIPE_PRICE_* variables are
# ignored and can be deleted. The webhook endpoint
# (https://www.saasfounder.fr/api/stripe/webhook) listens to
# checkout.session.completed, checkout.session.expired,
# customer.subscription.updated and customer.subscription.deleted.

# Contact shown on the pricing page, the terms and the refund page (refund
# requests go there). Defaults to contact@saasfounder.fr.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional: WhatsApp number with country code, digits only (33612345678).
# Shows "Écris-moi sur WhatsApp" on the pricing page.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Emails (resend.com): the one reminder sent to members who leave Stripe
# Checkout without paying, if they ticked the box on the pricing cards.
# EMAIL_FROM must be on a domain verified in Resend. Unset: no email, the
# rest works the same.
RESEND_API_KEY=
EMAIL_FROM="SaaSFounder <bonjour@saasfounder.fr>"
# Optional: where replies go.
EMAIL_REPLY_TO=
