# Supabase — create a project at https://supabase.com/dashboard, then copy
# these from Project Settings > API. Auth (email/password + Google) and the
# onboarding_responses table both depend on these being set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API > service_role key. Server-only, never exposed to
# the browser — used to read the Stripe key each user connects in /espace
# (that table has no client SELECT policy by design).
SUPABASE_SERVICE_ROLE_KEY=

# console.mistral.ai > API Keys. Server-only. Powers the build/marketing
# prompt generator and the in-app assistant; both fall back to static
# content when this is unset.
MISTRAL_API_KEY=

# SaaSFounder's own subscription billing (Stripe Dashboard > Developers >
# API keys / Webhooks). Distinct from the per-user Stripe keys stored in
# stripe_connections, which read each user's OWN account for their MRR.
# Without these, /tarifs still renders but "Choisir" fails gracefully.
STRIPE_SECRET_KEY=
# From the webhook endpoint's "Signing secret" once created (see below).
STRIPE_WEBHOOK_SECRET=
