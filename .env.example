# Supabase — create a project at https://supabase.com/dashboard, then copy
# these from Project Settings > API. Auth (email/password + Google) and the
# onboarding_responses table both depend on these being set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API > service_role key. Server-only, never exposed to
# the browser — used to read the Stripe key each user connects in /espace
# (that table has no client SELECT policy by design).
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys. Server-only. Powers the build/marketing
# prompt generator and the in-app assistant (including screenshot analysis);
# both fall back to static content when this is unset.
ANTHROPIC_API_KEY=

# SaaSFounder's own subscription billing (Stripe Dashboard > Developers >
# API keys / Webhooks). Distinct from the per-user Stripe keys stored in
# stripe_connections, which read each user's OWN account for their MRR.
# Without these, /tarifs still renders but "Choisir" fails gracefully.
STRIPE_SECRET_KEY=
# From the webhook endpoint's "Signing secret" once created (see below).
STRIPE_WEBHOOK_SECRET=

# The Price ID (not Product ID) behind each plan on /tarifs — Stripe
# Dashboard > Product catalog > click the product > copy the price's ID
# (starts with "price_"). Must be in the SAME mode (test/live) as
# STRIPE_SECRET_KEY above, or checkout fails with "No such price". Each
# price must match /tarifs exactly (checkout refuses it otherwise):
#   monthly   16,99 € every month    (unset: falls back to the live price)
#   quarterly 27,99 € every 3 months (unset: falls back to the live price)
#   annual    67,99 € every year     (unset: falls back to the live price)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=
# The standard prices (+60 %), charged once a member's 10-minute launch
# offer has expired: 27,19 € / 44,79 € every 3 months / 108,79 € a year.
# Unset: falls back to the live prices.
STRIPE_PRICE_MONTHLY_STANDARD=
STRIPE_PRICE_QUARTERLY_STANDARD=
STRIPE_PRICE_ANNUAL_STANDARD=
